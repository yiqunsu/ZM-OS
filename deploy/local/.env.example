# Shared Docker local configuration. Start with ./deploy/local/up.sh.
# Casdoor and Phoenix are enabled by --casdoor / --phoenix, not AUTH_PROVIDER.
AUTH_SECRET=replace-with-a-random-local-secret
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
AGENT_V2_ENABLED=true
LOG_LEVEL=INFO
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional AI; leave the key blank for ordinary business pages only.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=deepseek-flash
LLM_VISION_THINKING=disabled
LLM_VISION_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=60

# Optional Casdoor: fill these before starting with --casdoor.
# Separate cookie secret preserves the existing Casdoor login configuration.
CASDOOR_AUTH_SECRET=replace-with-a-local-authjs-secret
CASDOOR_ISSUER=http://localhost:8001
CASDOOR_REDIRECT_URI=http://localhost:3000/api/auth/callback/casdoor
CASDOOR_DB=casdoor_local
CASDOOR_DB_USER=casdoor_local
CASDOOR_DB_PASSWORD=replace-with-a-local-database-password
CASDOOR_CLIENT_ID=filmos-local
CASDOOR_CLIENT_SECRET=replace-with-a-local-oidc-client-secret
CASDOOR_ADMIN_EMAIL=casdoor-admin@example.test
CASDOOR_ADMIN_PASSWORD=replace-with-a-local-admin-password
CASDOOR_OWNER_NAME=filmos-owner
CASDOOR_OWNER_EMAIL=owner@example.test
CASDOOR_OWNER_PASSWORD=replace-with-a-local-owner-password
