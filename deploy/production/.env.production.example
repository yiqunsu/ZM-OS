# ICP pending (safe default): Caddy binds only to loopback. Add these names to
# the Mac's /etc/hosts and reach them through the documented SSH tunnel.
WEB_BIND_IP=127.0.0.1
APP_SITE_ADDRESS=http://app.filmos.test
AUTH_SITE_ADDRESS=http://auth.filmos.test
APP_PUBLIC_URL=http://app.filmos.test:8080
NEXTAUTH_URL=http://app.filmos.test:8080
# Browser API base, embedded in the frontend bundle during image build.
NEXT_PUBLIC_API_URL=/api
CASDOOR_ISSUER=http://auth.filmos.test:8080
CASDOOR_REDIRECT_URI=http://app.filmos.test:8080/api/auth/callback/casdoor

# Generate all secrets on the server. Use URI-safe hex values for database
# passwords because they are embedded in connection strings.
POSTGRES_USER=filmos
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_24
POSTGRES_DB=filmos
AUTH_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32

CASDOOR_DB_USER=casdoor
CASDOOR_DB_PASSWORD=CHANGE_ME_CASDOOR_DB_WITH_OPENSSL_RAND_HEX_24
CASDOOR_DB=casdoor
CASDOOR_CLIENT_ID=CHANGE_ME_WITH_OPENSSL_RAND_HEX_16
CASDOOR_CLIENT_SECRET=CHANGE_ME_CASDOOR_CLIENT_WITH_OPENSSL_RAND_HEX_32

# These two accounts are deliberately distinct. CASDOOR_OWNER_EMAIL must match
# the existing FilmOS owner's normalized email to preserve its local user ID.
CASDOOR_ADMIN_EMAIL=admin@zmorder.cn
CASDOOR_ADMIN_PASSWORD=CHANGE_ME_CASDOOR_ADMIN_WITH_OPENSSL_RAND_BASE64_32
CASDOOR_OWNER_NAME=owner
CASDOOR_OWNER_EMAIL=owner@zmorder.cn
CASDOOR_OWNER_PASSWORD=CHANGE_ME_FILMOS_OWNER_WITH_OPENSSL_RAND_BASE64_32

# Enable only after ICP approval, public HTTPS activation, and approval of a
# WeChat Open Platform website application for auth.zmorder.cn.
WECHAT_LOGIN_ENABLED=false
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=

LOG_LEVEL=INFO

# OpenClaw is private and remains independent of Casdoor.
AGENT_RUNTIME=langgraph
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# Legacy LangGraph rollback settings only.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
