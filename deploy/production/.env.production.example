# FilmOS 生产环境配置
# 与另一环境保持相同分组及公共字段顺序；仅列出本环境使用的字段。
# 实际配置不提交 Git；示例中的占位符需在使用前替换。
# 启动：./deploy/production/scripts/deploy.sh

# ---------- 1. 访问地址 ----------
# 示例默认 loopback + SSH 隧道；公网部署请按 README 配置绑定地址和 HTTPS 域名。
APP_PUBLIC_URL=http://app.filmos.test:8080
NEXTAUTH_URL=http://app.filmos.test:8080
# 浏览器 API 地址，构建前端时写入；修改后需重新构建。
NEXT_PUBLIC_API_URL=/api
WEB_BIND_IP=127.0.0.1
APP_SITE_ADDRESS=http://app.filmos.test
AUTH_SITE_ADDRESS=http://auth.filmos.test

# ---------- 2. 登录与会话 ----------
# 各环境使用独立随机密钥，不复用数据库或登录客户端密码。
AUTH_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
# 浏览器可访问的 Casdoor 地址。
CASDOOR_ISSUER=http://auth.filmos.test:8080
CASDOOR_REDIRECT_URI=http://app.filmos.test:8080/api/auth/callback/casdoor
CASDOOR_CLIENT_ID=CHANGE_ME_WITH_OPENSSL_RAND_HEX_16
CASDOOR_CLIENT_SECRET=CHANGE_ME_CASDOOR_CLIENT_WITH_OPENSSL_RAND_HEX_32

# ---------- 3. 数据库 ----------
POSTGRES_DB=filmos
POSTGRES_USER=filmos
# 数据库密码使用 URI 安全的随机十六进制值。
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_24
CASDOOR_DB=casdoor
CASDOOR_DB_USER=casdoor
# Casdoor 使用独立数据库账号；密码使用 URI 安全的随机十六进制值。
CASDOOR_DB_PASSWORD=CHANGE_ME_CASDOOR_DB_WITH_OPENSSL_RAND_HEX_24

# ---------- 4. 初始账号 ----------
# Casdoor 平台管理员，与下面的 FilmOS 业务管理员是不同账号。
CASDOOR_ADMIN_EMAIL=admin@zmorder.cn
CASDOOR_ADMIN_PASSWORD=CHANGE_ME_CASDOOR_ADMIN_WITH_OPENSSL_RAND_BASE64_32
CASDOOR_OWNER_NAME=owner
# 关联已有业务账号时，填写其原有邮箱，以保留用户 ID。
CASDOOR_OWNER_EMAIL=owner@zmorder.cn
CASDOOR_OWNER_PASSWORD=CHANGE_ME_FILMOS_OWNER_WITH_OPENSSL_RAND_BASE64_32

# ---------- 5. 微信登录 ----------
# 仅在公网 HTTPS、域名及微信开放平台网站应用审核完成后启用。
WECHAT_LOGIN_ENABLED=false
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=

# ---------- 6. AI 模型 ----------
AGENT_V2_ENABLED=true
# 填写自己的模型供应商 Key；模型名称不代表供应商可用性已验证。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=deepseek-flash
# DeepSeek 视觉扩展：disabled / enabled / provider_default；其他供应商不发送此参数。
LLM_VISION_THINKING=disabled
LLM_VISION_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---------- 7. 日志与错误监控 ----------
LOG_LEVEL=INFO
