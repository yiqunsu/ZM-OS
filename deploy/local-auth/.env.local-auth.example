APP_PUBLIC_URL=http://localhost:3000
CASDOOR_ISSUER=http://localhost:8001
CASDOOR_REDIRECT_URI=http://localhost:3000/api/auth/callback/casdoor

CASDOOR_DB=casdoor_local
CASDOOR_DB_USER=casdoor_local
CASDOOR_DB_PASSWORD=replace-with-a-local-database-password

CASDOOR_CLIENT_ID=filmos-local
CASDOOR_CLIENT_SECRET=replace-with-a-local-oidc-client-secret
AUTH_SECRET=replace-with-a-local-authjs-secret

CASDOOR_ADMIN_EMAIL=casdoor-admin@example.test
CASDOOR_ADMIN_PASSWORD=replace-with-a-local-admin-password
CASDOOR_OWNER_NAME=filmos-owner
# Set this to an existing FilmOS OWNER email to exercise the one-time account link.
CASDOOR_OWNER_EMAIL=owner@example.test
CASDOOR_OWNER_PASSWORD=replace-with-a-local-owner-password
