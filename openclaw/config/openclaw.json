{
  gateway: {
    mode: "local",
    bind: "lan",
    port: 18789,
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
      rateLimit: {
        maxAttempts: 10,
        windowMs: 60000,
        lockoutMs: 300000,
      },
    },
    controlUi: { enabled: false },
    http: {
      endpoints: {
        responses: {
          enabled: true,
          files: { allowUrl: false },
          images: { allowUrl: false },
        },
        chatCompletions: { enabled: false },
      },
    },
  },
  browser: { enabled: false },
  tools: {
    profile: "minimal",
    deny: ["session_status"],
    elevated: { enabled: false },
  },
  models: {
    mode: "replace",
    providers: {
      "filmos-qwen": {
        baseUrl: "${LLM_BASE_URL}",
        apiKey: "${LLM_API_KEY}",
        api: "openai-completions",
        models: [
          {
            id: "${LLM_MODEL}",
            name: "FilmOS Qwen",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 1000000,
            contextTokens: 900000,
            maxTokens: 32768,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      workspace: "/workspace",
      skipBootstrap: true,
      skills: [],
    },
    list: [
      {
        id: "filmos-web",
        default: true,
        name: "FilmOS Web Agent",
        workspace: "/workspace",
        model: { primary: "filmos-qwen/${LLM_MODEL}" },
        skills: [],
        tools: {
          profile: "minimal",
          deny: ["session_status"],
          elevated: { enabled: false },
        },
      },
    ],
  },
  skills: {
    workshop: {
      autonomous: { enabled: false },
    },
  },
}
